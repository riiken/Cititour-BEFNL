# MongoDB
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secrets (generate random strings)
JWT_SECRET=your_super_secret_jwt_key_here_use_random_string
JWT_REFRESH_SECRET=your_refresh_token_secret_here_use_random_string

# Google Gemini AI (FREE - replaces OpenAI)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq AI (FREE - fallback)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration (for contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
RECIPIENT_EMAIL=your_recipient_email@example.com

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:4200
FRONTEND_URL_PROD=https://yourdomain.com

# Server Configuration
PORT=5000
NODE_ENV=development

# Optional: Pexels API for images
PEXELS_API_KEY=your_pexels_key_here
