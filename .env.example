# ===== Required =====
MONGODB_URI=your_mongodb_connection_string_here
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_use_random_string
JWT_REFRESH_SECRET=your_refresh_token_secret_here_use_random_string

# ===== Server =====
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
FRONTEND_URL_PROD=https://yourdomain.com
# Number of proxies in front of the app (Render: 1)
TRUST_PROXY_HOPS=1
# Write rotating log files under logs/ (default: only in development)
LOG_TO_FILES=

# ===== AI (Gemini primary, Groq fallback) =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Cost controls
AI_ENABLED=true
AI_DAILY_GENERATION_LIMIT=500
AI_GUIDE_CACHE_DAYS=30

# ===== Hotels / restaurants / tours (RapidAPI TripAdvisor scraper) =====
RAPIDAPI_KEY=your_rapidapi_key_here
TRIPADVISOR_API_URL=https://real-time-tripadvisor-scraper-api.p.rapidapi.com
PLACE_CACHE_DAYS=7

# ===== Destination data =====
OPENWEATHER_API_KEY=your_openweather_key_here
UNSPLASH_API_KEY=your_unsplash_key_here
DESTINATION_CACHE_MINUTES=30

# ===== Revenue: affiliate programmes (links work without them, unattributed) =====
# Booking.com Affiliate Partner Programme
BOOKING_AFFILIATE_ID=
BOOKING_AFFILIATE_LABEL=cititour
# GetYourGuide partner programme
GYG_PARTNER_ID=

# ===== Contact form email (SMTP) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=
RECIPIENT_EMAIL=your_recipient_email@example.com

# ===== Identity for public APIs (Wikimedia/OSM require contact info) =====
APP_URL=https://cititour.onrender.com
CONTACT_EMAIL=
ITINERARY_REUSE_DAYS=7

# ===== Admin access (comma-separated emails; log out and back in after changing) =====
ADMIN_EMAILS=

# ===== Trip reminder emails (2 days before saved trips) =====
# Default: on in production, off in development
REMINDERS_ENABLED=
# Public URL of this API (used in unsubscribe links), e.g. https://cititour-befnl.onrender.com
API_URL=
